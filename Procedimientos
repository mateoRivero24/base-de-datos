5- Actualizar el precio de un producto
Create Procedure g as
@descripcion varchar
@marca varchar
@precio decimal(10,2)
@stock int 
begin
Update producto(descripcion,marca,precio,stock) values (@descripcion,@marca,@precio,@stock);
set precio = 222
where descripcion = "polio"
END

exec g;

6- Actualizar el stock de un producto
Create Procedure i as
@descripcion varchar
@marca varchar
@precio decimal(10,2)
@stock int 
begin
Update producto(descripcion,marca,precio,stock) values (@descripcion,@marca,@precio,@stock);
set stock = 99
where descripcion = "polio"
END

exec i;

