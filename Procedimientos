1 - Agregar una provincia

Create Procedure l AS 
@provincia int
@nombre varchar
@capital varchar
@gobernador varchar
@poblacion int
@superficie 
@autonoma DATE
Begin
insert into provincias(provincia,nombre,capital,gobernador,poblacion,superficie,autonoma) values (@provincia,@nombre,@capital,@gobernador,@poblacion,@superficie,@autonoma);

END;
Exec l  25, "paraguay", "asuncion","jose perez de peru", 100, 173000, 02/06/2026;

