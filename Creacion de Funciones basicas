CREATE FUNCTION estado_stock(stock int);
RETURNS int;  
BEGIN
IF stock = 0 THEN
RETURN "Sin stock";
ELSE
IF stock < 20 THEN
RETURN "Bajo";
ELSE
RETURN "disponible"; 
END IF;
END //
DELIMITER ;

