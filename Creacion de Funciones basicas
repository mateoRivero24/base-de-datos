7- DELIMITER //
CREATE FUNCTION obtener_precio(id_producto int)
RETURNS DECIMAL(10,2)
BEGIN
DECLARE precio_producto DECIMAL(10,2);
SELECT precio;
INTO precio_producto;
FROM productos;
WHERE id = id_producto;
RETURN precio_producto;
END //
DELIMITER ;

8- DELIMITER //
CREATE FUNCTION obtener_stock(id_producto int)
RETURNS id_producto;
BEGIN
DECLARE id_producto int;
SELECT stock
FROM producto
WHERE id = id_producto;
RETURN id_producto;
END //
DELIMITER ;

