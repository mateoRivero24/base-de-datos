on productos.stock, productos.precios
to TTT;
CREATE TRIGGER
BEFORE DELETE ON stock
FOR EACH ROW
BEGIN
if (stock > 0) then
Raise exeption 'No se puede eliminar productos con stock';
else return '✔';
end if;
END;
Delimiter;

