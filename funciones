DELIMITER //
CREATE FUNCTION alerta_stock(id_producto INT)
RETURNS VARCHAR(25)
DETERMINISTIC
BEGIN
DECLARE stocc INT;
SELECT stock INTO stocc FROM productos WHERE id = id_producto;
IF stocc = 0 THEN
RETURN 'REPOSICION URGENTE';
ELSE IF stocc < 20 THEN
RETURN 'STOCK BAJO';
ELSE
RETURN 'OK';
END IF;
END //
DELIMITER ;


