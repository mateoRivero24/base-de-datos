DELIMITER //
CREATE FUNCTION producto_mas_vendido()
RETURNS VARCHAR(60)
DETERMINISTIC
BEGIN
DECLARE prod_nombre VARCHAR(60);
SELECT p.descripcion INTO prod_nombre FROM compras c JOIN productos p ON c.producto = p.id GROUP BY c.producto, p.descripcion ORDER BY SUM(c.cant) DESC LIMIT 1;
RETURN prod_nombre;
END //
DELIMITER ;

