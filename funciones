DELIMITER //
CREATE FUNCTION comparar_promedio(id_producto INT)
RETURNS VARCHAR(30)
DETERMINISTIC
BEGIN
DECLARE prome DECIMAL(7,2);
DECLARE precio_prod DECIMAL(7,2);
SET prome = promedio_precios();
SELECT precio INTO precio_prod FROM productos WHERE id = id_producto;
IF precio_prod > prome     
RETURN 'Arriba del promedio';
ELSE
RETURN 'Debajo del promedio';
END IF;
END //
DELIMITER ;

