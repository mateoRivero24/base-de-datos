DELIMITER //
CREATE FUNCTION determinar_nivel_cliente(id_cliente INT)
RETURNS VARCHAR(60)
DETERMINISTIC
BEGIN
    DECLARE gastado DECIMAL(10,2);
    
    SELECT SUM(c.cant * p.precio) INTO gastado FROM compras c JOIN productos p ON c.producto = p.id WHERE c.cliente = id_cliente;
   
    IF gastado IS NULL THEN
        SET gastado = 0.00;
    END IF;
    
   
    IF gastado < 1000 THEN
        RETURN 'Bronce';
    ELSEIF gastado < 3000 THEN
        RETURN 'Plata';
    ELSEIF gastado < 5000 THEN
        RETURN 'ORO';
    ELSE
        RETURN 'PLATINO';
    END IF;
END //



CREATE PROCEDURE mostrar_productos_por_nivel(rango_cliente VARCHAR(15))
BEGIN
 
IF rango_cliente = 'Bronce' THEN SELECT * FROM productos WHERE precio <= 10.00; 
ELSEIF rango_cliente = 'Plata' THEN SELECT * FROM productos WHERE precio <= 100.00;
ELSEIF rango_cliente = 'ORO' THEN SELECT * FROM productos WHERE precio <= 500.00;
ELSEIF rango_cliente = 'PLATINO' THEN SELECT * FROM productos WHERE precio <= 500.00;
END IF;
END //
