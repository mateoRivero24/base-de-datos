DELIMITER //

CREATE FUNCTION es_cliente_premium(id_cliente INT)
RETURNS VARCHAR(60)
DETERMINISTIC
BEGIN
    DECLARE total_gastado DECIMAL(10,2);
    
    SELECT SUM(c.cant * p.precio) INTO total_gastado 
    FROM compras c 
    JOIN productos p ON c.producto = p.id 
    WHERE c.cliente = id_cliente;
    
    IF total_gastado > 5000 THEN
        RETURN 'Premium';
    ELSE
        RETURN 'Normal';
    END IF;
END //

CREATE FUNCTION analisis_cliente(id_cliente INT)
RETURNS VARCHAR(60)
DETERMINISTIC
BEGIN
    DECLARE nom VARCHAR(120);
    DECLARE gastado DECIMAL(10,2);
    DECLARE tipo VARCHAR(15);
    
    SELECT CONCAT(nombre, ' ', apellido) INTO nom 
    FROM clientes 
    WHERE id = id_cliente;
   
    SELECT SUM(c.cant * p.precio) INTO gastado 
    FROM compras c 
    JOIN productos p ON c.producto = p.id 
    WHERE c.cliente = id_cliente;
    
    SET tipo = es_cliente_premium(id_cliente);
    
    RETURN CONCAT(nom, ' | Gasto: ', gastado, ' | ', tipo);
END //

DELIMITER ;

