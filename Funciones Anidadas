DELIMITER //


CREATE FUNCTION provincia_cliente(id_cliente INT)
RETURNS VARCHAR(60)
DETERMINISTIC
BEGIN
DECLARE nombre_provincia VARCHAR(60);

SELECT p.nombre INTO nombre_provincia FROM clientes c JOIN ciudades cd ON c.localidad = cd.id JOIN provincias p ON cd.provincia = p.id WHERE c.id = id_cliente;
RETURN nombre_provincia;
END //


CREATE FUNCTION Region_Cliente(id_cliente INT)
RETURNS VARCHAR(60)
DETERMINISTIC
BEGIN
DECLARE prov_nombre VARCHAR(60);
DECLARE nom_region VARCHAR(20);
    
SET prov_nombre = provincia_cliente(id_cliente);
    
SELECT region INTO nom_region FROM provincias WHERE nombre = prov_nombre; 
RETURN nom_region;
END //

DELIMITER ;


