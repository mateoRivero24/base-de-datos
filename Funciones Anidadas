DELIMITER //

CREATE FUNCTION tiene_largo_correcto(p VARCHAR(60))
RETURNS INT
DETERMINISTIC
BEGIN
IF CHAR_LENGTH(p) >= 8 THEN
RETURN 1;
ELSE
RETURN 0;
END IF;
END //

CREATE FUNCTION tiene_numero(p VARCHAR(60))
RETURNS INT
DETERMINISTIC
BEGIN
IF p LIKE '%0%' OR p LIKE '%1%' OR p LIKE '%2%' OR p LIKE '%3%' OR p LIKE '%4%' OR p LIKE '%5%' OR p LIKE '%6%' OR p LIKE '%7%' OR p LIKE '%8%' OR p LIKE '%9%' THEN
RETURN 1;
ELSE
RETURN 0;
END IF;
END //

CREATE FUNCTION tiene_caracter_especial(p VARCHAR(60))
RETURNS INT
DETERMINISTIC
BEGIN
IF p LIKE '%!%' OR p LIKE '%-%' OR p LIKE '%\%%' OR p LIKE '%&%' OR p LIKE '%$%' THEN
RETURN 1;
ELSE
RETURN 0;
END IF;
END //

CREATE FUNCTION password_valida(p VARCHAR(60))
RETURNS VARCHAR(25)
DETERMINISTIC
BEGIN
IF tiene_largo_correcto(p) = 1 AND tiene_numero(p) = 1 AND tiene_caracter_especial(p) = 1 THEN
RETURN 'Contraseña aceptada';
ELSE
RETURN 'Contraseña insegura';
END IF;
END //
DELIMITER ;
