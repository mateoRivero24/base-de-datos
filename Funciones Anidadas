DELIMITER //

CREATE FUNCTION alerta_stock(id_producto INT)
RETURNS VARCHAR(130)
DETERMINISTIC
BEGIN
DECLARE stocc INT;
    
SELECT stock INTO stocc FROM productos WHERE id = id_producto;
    
IF stocc = 0 THEN
RETURN 'REPOSICION URGENTE';
ELSEIF stocc < 20 THEN
RETURN 'STOCK BAJO';
ELSE
RETURN 'OK';
END IF;
END //

CREATE FUNCTION estado_producto(id_producto INT)
RETURNS VARCHAR(60)
DETERMINISTIC
BEGIN
DECLARE nom VARCHAR(60);
DECLARE stock_actual INT;
DECLARE vendidos INT;
DECLARE alerta VARCHAR(60);
    
SELECT descripcion, stock INTO nom, stock_actual FROM productos WHERE id = id_producto;
     
SELECT SUM(cant) INTO vendidos FROM compras WHERE producto = id_producto;
    
SET alerta = alerta_stock(id_producto);
    
RETURN CONCAT('Producto: ', nom, ' | Vendidos: ', vendidos, ' | Stock: ', stock_actual, ' | ', alerta);
END //

