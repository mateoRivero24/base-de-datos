Create table HistorialCambios (regidh int primary key auto_increment, fecha_intento DATETIME, campo_modificado varchar(100), LibroID int, Foreign key (LibroID) References Libros(LibroID));
Delimiter//
CREATE TRIGGER historialf
BEFORE UPDATE ON Libros
FOR EACH ROW
BEGIN
DECLARE nombre_campo VARCHAR(100);

IF NEW.Titulo <> OLD.Titulo
THEN
SET nombre_campo = 'Titulo';
INSERT INTO HistorialCambios (fecha_intento, campo_modificado, LibroID) VALUES (NOW(), nombre_campo, OLD.LibroID);
END IF;
END;
Delimiter;

